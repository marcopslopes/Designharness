{
  "name": "design-harness",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "author": "Marco Lopes",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run -s design:check && npm run -s docs:check && npm run -s ds:index -- --check && tsc -b && vite build",
    "lint": "eslint .",
    "benchmark": "node scripts/benchmark.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.{ts,mjs,js}\" \"tests/**/*.ts\" \"*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.{ts,mjs,js}\" \"tests/**/*.ts\" \"*.{ts,js,json}\"",
    "preview": "vite preview",
    "confluence:put-draft-body": "node scripts/research-agent/confluence-put-page-body.mjs",
    "export-task-prototype": "node scripts/export-task-prototype.mjs",
    "capture-page": "node scripts/capture-page.mjs",
    "design:detect": "node scripts/design-detector/detect.mjs",
    "design:check": "node scripts/design-detector/check-baseline.mjs",
    "docs:check": "node scripts/check-docs-facts.mjs",
    "ds:index": "node scripts/ds-index.mjs",
    "harness:context": "node scripts/harness-context.mjs",
    "skills:package": "node scripts/build-skills-package.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "setup:claude-skills": "bash scripts/setup-claude-skills.sh",
    "setup:claude-skills-windows": "node scripts/setup-claude-skills-windows.js",
    "setup:all-platforms": "npm run setup:claude-skills || npm run setup:claude-skills-windows",
    "test": "node --experimental-strip-types --test 'tests/unit/*.test.ts'"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@solar-icons/react": "^2.3.3",
    "@tabler/icons-react": "^3.44.0",
    "@types/qrcode": "^1.5.6",
    "mermaid": "^11.17.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "marked": "^18.0.5",
    "playwright": "^1.61.1",
    "prettier": "3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
